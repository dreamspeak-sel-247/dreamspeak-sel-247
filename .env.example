# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU - DREAMSPEAK-SEL (HIỆP SĨ TỰ VẤN 24/7)
# Sao chép file này thành .env (hoặc cấu hình trong Google Cloud Secret Manager)
# TUYỆT ĐỐI KHÔNG ĐƯA KHÓA BÍ MẬT THẬT VÀO FILE NÀY HOẶC LÊN GITHUB
# ============================================================================

# Cổng chạy máy chủ Backend (Cloud Run mặc định dùng 8080)
PORT=8080
NODE_ENV=production

# Khóa API Google Gemini chính thức (Lấy tại https://aistudio.google.com/apikey)
# Hệ thống ưu tiên sử dụng Google Gemini API khi biến này được cấu hình
GEMINI_API_KEY=your_google_gemini_api_key_here

# Phiên bản mô hình Gemini ưu tiên (Hỗ trợ tiếng Việt, Toán học LaTeX và Thị giác Vision)
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash

# Mã PIN Quản trị viên để truy cập trang /admin và cấu hình Secret Key trực tuyến
ADMIN_ACCESS_CODE=DREAMSPEAK2026

# Cấu hình giới hạn bảo vệ máy chủ & kiểm soát chi phí (Rate Limiting & Budget Guard)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=25
DAILY_SESSION_MESSAGE_LIMIT=150
DAILY_GLOBAL_TOKEN_BUDGET=2000000
BUDGET_WARNING_THRESHOLD_PERCENT=80
MAX_QUESTION_LENGTH=4000
MAX_IMAGE_SIZE_MB=8

# Địa chỉ truy cập công khai của ứng dụng (Dùng để tạo Mã QR và đường link chia sẻ)
PUBLIC_APP_URL=https://dreamspeak-sel.web.app
